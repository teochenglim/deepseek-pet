{
  "_comment": "将此文件复制为 config.json 后按需自定义。值为 null 的字段会被自动检测。",
  "pet_id": "big-blue-fish",
  "pet_base_dir": null,
  "frames_dir": null,
  "event_endpoint": null,
  "socket_path": "/tmp/kotori-pet.sock",
  "sessions_dir": null,
  "renderer": {
    "scale": 0.6,
    "fps": 10,
    "_frame_timing_comment": "Per-frame hold in ticks (fps ticks). Big Blue Fish idle is 8 frames, 3 ticks each = 2.4s breathing loop at 10fps.",
    "frame_timing": {
      "default": {
        "holds": [1]
      },
      "idle": {
        "holds": [3, 3, 3, 3, 3, 3, 3, 3]
      }
    },
    "_stale_timeout_sec_comment": "会话文件保持不变多久（秒）后被视为已死。1h 覆盖读取/思考/长时间工具调用；崩溃的进程在此 TTL 后被清理。",
    "stale_timeout_sec": 3600,
    "cleanup_interval_sec": 30,
    "corner_margin": 20
  },
  "dialogue": {
    "font_size": 10,
    "max_width": 160,
    "cornerRadius": 6,
    "fade_duration_sec": 0.3,
    "style_map": {
      "waiting": "warning",
      "failed": "error"
    }
  },
  "hooks": {
    "_python_command_comment": "仅 Windows：运行宠物 hook 脚本的确切命令。null = 自动探测（python / py -3）。可设为 'python'、'py -3' 或 'C:/Python313/python.exe' 以固定解释器，避免 conda/PATH 漂移——写入任何 hook 前会用 `<cmd> --version` 校验，失败则中止安装。",
    "python_command": null,
    "claude_code_settings": null,
    "codex_hooks": null,
    "opencode_plugins_dir": null
  },
  "terminal_events": ["SessionEnd"],
  "state_map": {
    "SessionStart": {
      "state": "waving",
      "dialogue": "Hi!"
    },
    "UserPromptSubmit": {
      "state": "running",
      "dialogue": "On it!"
    },
    "PreToolUse": {
      "state": "running",
      "dialogue": "Working..."
    },
    "Stop": {
      "state": "jumping",
      "dialogue": "Done!"
    },
    "StopFailure": {
      "state": "failed",
      "dialogue": "Something went wrong"
    },
    "Notification": {
      "state": "waving",
      "dialogue": "Heads up"
    },
    "PermissionRequest": {
      "state": "waiting",
      "dialogue": "Needs your approval"
    },
    "SubagentStop": {
      "state": "idle",
      "dialogue": ""
    },
    "PreCompact": {
      "state": "waiting",
      "dialogue": "Tidying memory..."
    },
    "SessionEnd": {
      "state": "waving",
      "dialogue": "See you!"
    },
    "QuestionAsked": {
      "state": "waiting",
      "dialogue": "Needs your choice"
    },
    "PostToolUseFailure": {
      "state": "failed",
      "dialogue": "Something went wrong"
    }
  },
  "menu": {
    "items": [
      {
        "title": "关闭宠物",
        "action": "quit"
      }
    ]
  }
}
